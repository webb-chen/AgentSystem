# ===== server =====
MINGYINGKEJI_SANDBOX_SERVER_PORT=2660
MINGYINGKEJI_SANDBOX_API_KEY=

# ===== public urls =====
MINGYINGKEJI_SANDBOX_ADVERTISE_URL=http://localhost:2660
MINGYINGKEJI_SANDBOX_PUBLIC_BASE_URL=http://localhost:2660

# ===== runtime =====
MINGYINGKEJI_SANDBOX_ENV=local
MINGYINGKEJI_SANDBOX_RUNTIME_BACKEND=preview
MINGYINGKEJI_SANDBOX_DATA_DIR=/var/lib/mingyingkeji-sandbox

# ===== execution limits =====
MINGYINGKEJI_SANDBOX_LITE_MAX_WORKERS=4
MINGYINGKEJI_SANDBOX_LITE_WORKER_TIMEOUT=5
MINGYINGKEJI_SANDBOX_OUTPUT_LIMIT_KB=64
MINGYINGKEJI_SANDBOX_MAX_ACTIVE=6
MINGYINGKEJI_SANDBOX_MAX_ACTIVE_PER_ORGANIZATION=0
MINGYINGKEJI_SANDBOX_MAX_CONCURRENT_EXECUTIONS=0
MINGYINGKEJI_SANDBOX_MAX_CONCURRENT_EXECUTIONS_PER_PROFILE=0
MINGYINGKEJI_SANDBOX_MAX_CONCURRENT_EXECUTIONS_PER_ORGANIZATION=0
MINGYINGKEJI_SANDBOX_MAX_EXECUTIONS_PER_MINUTE_PER_ORGANIZATION=0
MINGYINGKEJI_SANDBOX_MAX_NETWORK_REQUESTS_PER_MINUTE_PER_ORGANIZATION=0
MINGYINGKEJI_SANDBOX_MAX_QUEUED_EXECUTIONS_PER_ORGANIZATION=0
MINGYINGKEJI_SANDBOX_QUEUE_TIMEOUT_MS=5000
MINGYINGKEJI_SANDBOX_SHUTDOWN_TIMEOUT_SECONDS=10
MINGYINGKEJI_SANDBOX_SESSION_TTL_SECONDS=1800
MINGYINGKEJI_SANDBOX_INTERACTIVE_TTL_SECONDS=3600
MINGYINGKEJI_SANDBOX_COMMAND_TIMEOUT_SECONDS=15
MINGYINGKEJI_SANDBOX_MAX_FILE_SIZE_KB=256
MINGYINGKEJI_SANDBOX_MAX_WORKSPACE_FILES=0
MINGYINGKEJI_SANDBOX_MAX_WORKSPACE_BYTES=0
MINGYINGKEJI_SANDBOX_MAX_WORKSPACE_BYTES_PER_ORGANIZATION=0
MINGYINGKEJI_SANDBOX_MAX_ARTIFACT_MANIFEST_FILES=0
MINGYINGKEJI_SANDBOX_MAX_ARTIFACT_MANIFEST_BYTES=0
MINGYINGKEJI_SANDBOX_MAX_ARTIFACT_BYTES_PER_ORGANIZATION=0
MINGYINGKEJI_SANDBOX_MAX_DEPENDENCY_PROFILES_PER_ORGANIZATION=0
MINGYINGKEJI_SANDBOX_MAX_DEPENDENCY_PROFILE_SIZE_BYTES=1073741824
MINGYINGKEJI_SANDBOX_DEPENDENCY_PROFILE_BUILD_TIMEOUT_SECONDS=600
MINGYINGKEJI_SANDBOX_DEPENDENCY_BUILD_COMMAND=/usr/local/bin/mingyingkeji-sandbox-build-dependency-profile
MINGYINGKEJI_SANDBOX_DEPENDENCY_BUILD_WORKER_ENABLED=true
MINGYINGKEJI_SANDBOX_DEPENDENCY_BUILD_WORKER_INTERVAL_SECONDS=2
MINGYINGKEJI_SANDBOX_REQUIRED_DEPENDENCY_PROFILES=skill-office
MINGYINGKEJI_SANDBOX_CACHE_TTL_SECONDS=30
MINGYINGKEJI_SANDBOX_PROXY_TIMEOUT_SECONDS=20
MINGYINGKEJI_SANDBOX_EGRESS_PROXY_MAX_BODY_BYTES=1048576

# ===== observer retention =====
MINGYINGKEJI_SANDBOX_OBSERVER_RETENTION_DAYS=7
MINGYINGKEJI_SANDBOX_OBSERVER_MAX_EVENTS=10000

# ===== internal services =====
MINGYINGKEJI_SANDBOX_DATABASE_URL=
MINGYINGKEJI_SANDBOX_REDIS_ADDR=sandbox-redis:6379
MINGYINGKEJI_SANDBOX_REDIS_PASSWORD=
MINGYINGKEJI_SANDBOX_REDIS_DB=0

# ===== compose postgres =====
POSTGRES_DB=mingyingkeji_sandbox
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ===== worker =====
MINGYINGKEJI_SANDBOX_WORKER_ID=mingyingkeji-sandbox-local

# ===== secure runtime optional =====
MINGYINGKEJI_SANDBOX_SECURE_ROOTFS=
MINGYINGKEJI_SANDBOX_DEPENDENCY_ROOTFS_DIR=/var/lib/mingyingkeji-sandbox/dependency-rootfs
MINGYINGKEJI_SANDBOX_PREBUILT_DEPENDENCY_ROOTFS_DIR=/opt/mingyingkeji/prebuilt-dependency-rootfs
MINGYINGKEJI_SANDBOX_BWRAP_BINARY=bwrap
MINGYINGKEJI_SANDBOX_SECURE_RUNTIME_CPU_SECONDS=2
MINGYINGKEJI_SANDBOX_SECURE_RUNTIME_MEMORY_BYTES=268435456
MINGYINGKEJI_SANDBOX_SECURE_RUNTIME_PROCESS_LIMIT=64
MINGYINGKEJI_SANDBOX_SECURE_RUNTIME_OPEN_FILE_LIMIT=128
